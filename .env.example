# VedaAI - Environment Configuration Template
# 
# Copy this file to .env.local and update with your actual values
# Never commit .env.local to version control

# ================================================
# FRONTEND CONFIGURATION (Next.js)
# ================================================

# Backend API URL
# Development: http://localhost:5000
# Production: https://ai-assesment-creator-x2jv.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# WebSocket URL (optional, defaults to NEXT_PUBLIC_API_URL)
# NEXT_PUBLIC_WS_URL=http://localhost:5000

# Node environment
NODE_ENV=development

# ================================================
# BACKEND CONFIGURATION (Express.js)
# ================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# MongoDB URI - Update with your MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/vedai
MONGODB_NAME=vedai_db

# Cache Configuration
# Redis URL for caching and job queue
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI Services Configuration
# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (GPT-4o for fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Logging Configuration
LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true

# ================================================
# DEPLOYMENT VARIABLES
# ================================================

# Frontend Deployment
VERCEL_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend Deployment
BACKEND_URL=http://localhost:5000
BACKEND_RENDER_URL=https://ai-assesment-creator-x2jv.onrender.com

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
